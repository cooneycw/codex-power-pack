{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cooneycw/codex-power-pack/blob/main/.agents/skill-evaluation-cases.schema.json",
  "title": "Codex Power Pack skill evaluation captures and runnable suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "captures", "suite"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "2.0"},
    "captures": {
      "type": "array",
      "items": {"$ref": "#/$defs/capture"},
      "minItems": 1
    },
    "suite": {"$ref": "#/$defs/suite"}
  },
  "$defs": {
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "captured_at",
        "source_commit",
        "codex_version",
        "profile",
        "inventory",
        "activation",
        "known_failures",
        "cases"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "captured_at": {"type": "string", "format": "date-time"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "codex_version": {"type": "string", "minLength": 1},
        "profile": {"type": "string", "minLength": 1},
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_skills",
            "packaged_skills",
            "unpackaged_skills",
            "marketplace_plugins",
            "implicit_skills",
            "system_entries",
            "cxpp_entries",
            "total_entries",
            "entry_metadata_bytes",
            "skills_section_bytes",
            "method"
          ],
          "properties": {
            "source_skills": {"type": "integer", "minimum": 0},
            "packaged_skills": {"type": "integer", "minimum": 0},
            "unpackaged_skills": {"type": "integer", "minimum": 0},
            "marketplace_plugins": {"type": "integer", "minimum": 0},
            "implicit_skills": {"type": "integer", "minimum": 0},
            "system_entries": {"type": "integer", "minimum": 0},
            "cxpp_entries": {"type": "integer", "minimum": 0},
            "total_entries": {"type": "integer", "minimum": 0},
            "entry_metadata_bytes": {"type": "integer", "minimum": 0},
            "skills_section_bytes": {"type": "integer", "minimum": 0},
            "method": {"type": "string", "minLength": 1}
          }
        },
        "activation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt_presence", "direct_recall", "indirect_recall", "negative_precision", "reason"],
          "properties": {
            "prompt_presence": {"enum": ["passed", "failed", "not_run", "unavailable"]},
            "direct_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "indirect_recall": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "negative_precision": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "known_failures": {
          "type": "array",
          "items": {"$ref": "#/$defs/known_failure"}
        },
        "cases": {
          "type": "array",
          "items": {"$ref": "#/$defs/case"},
          "minItems": 5
        }
      }
    },
    "known_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "owner", "tracking_issue", "disposition"],
      "properties": {
        "id": {"type": "string", "pattern": "^KF-[0-9]{3}$"},
        "summary": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "tracking_issue": {"type": "integer", "minimum": 1},
        "disposition": {"type": "string", "minLength": 1}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "prompt", "expected", "baseline"],
      "properties": {
        "id": {"type": "string", "pattern": "^CASE-[0-9]{3}$"},
        "category": {"enum": ["direct", "indirect", "negative", "incomplete", "edge"]},
        "prompt": {"type": "string", "minLength": 1},
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_skill", "procedure_checkpoint", "output_contract"],
          "properties": {
            "selected_skill": {"type": ["string", "null"]},
            "procedure_checkpoint": {"type": "string", "minLength": 1},
            "output_contract": {"type": "string", "minLength": 1}
          }
        },
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"enum": ["passed", "failed", "not_run", "unavailable"]},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tracking_issue", "thresholds", "live_defaults", "cases"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "tracking_issue": {"type": "integer", "minimum": 1},
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["direct_recall", "indirect_recall", "negative_precision"],
          "properties": {
            "direct_recall": {"type": "number", "minimum": 0, "maximum": 1},
            "indirect_recall": {"type": "number", "minimum": 0, "maximum": 1},
            "negative_precision": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "live_defaults": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout_seconds",
            "max_cases",
            "max_total_tokens",
            "max_output_bytes",
            "retention_days",
            "model"
          ],
          "properties": {
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 600},
            "max_cases": {"type": "integer", "minimum": 1, "maximum": 100},
            "max_total_tokens": {"type": "integer", "minimum": 1},
            "max_output_bytes": {"type": "integer", "minimum": 1024},
            "retention_days": {"type": "integer", "minimum": 1, "maximum": 90},
            "model": {"type": ["string", "null"], "minLength": 1}
          }
        },
        "cases": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/evaluation_case"}
        }
      }
    },
    "evaluation_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "skill", "category", "prompt", "lanes", "tags", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^CASE-[0-9]{3}$"},
        "skill": {"type": ["string", "null"], "minLength": 1},
        "category": {"enum": ["direct", "indirect", "negative", "incomplete", "edge"]},
        "prompt": {"type": "string", "minLength": 1},
        "lanes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["deterministic", "live"]}
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["selected_skill", "required_checkpoints", "required_output_fields", "forbidden_actions"],
          "properties": {
            "selected_skill": {"type": ["string", "null"]},
            "required_checkpoints": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "required_output_fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "forbidden_actions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "deterministic": {
          "type": "object",
          "required": ["adapter"],
          "properties": {
            "adapter": {"enum": ["skill_text", "project_next", "observation"]},
            "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "required_text": {"type": "array", "items": {"type": "string"}},
            "forbidden_text": {"type": "array", "items": {"type": "string"}},
            "contract_layer": {
              "enum": ["routing", "procedure", "artifact", "parser", "grouping", "issue-body", "mapping", "runtime", "output"]
            },
            "fixture": {"type": "string", "minLength": 1},
            "scenario": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      }
    }
  }
}
